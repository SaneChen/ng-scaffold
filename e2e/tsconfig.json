/*
 * Type-check browser tests separately from Angular app sources.
 * How this file was built: handwritten TypeScript config; no browser-test CLI generator.
 * Why: browser code needs DOM types, not implicit Node globals or Angular source inclusion.
 */
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM"],
    "types": []
  },
  "include": ["*.ts"]
}
