{
  "name": "ng-scaffold",
  "version": "0.0.0",
  "description": "Standalone Angular Material admin application schematics",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "schematics": "./collection.json",
  "ng-add": {
    "save": "devDependencies"
  },
  "ng-update": {
    "migrations": "./migration.json"
  },
  "sideEffects": false,
  "dependencies": {
    "@angular-devkit/core": "22.2.1",
    "@angular-devkit/schematics": "22.2.1",
    "@schematics/angular": "22.2.1",
    "typescript": "~6.0.2",
    "rxjs": "~7.8.0",
    "prettier": "^3.8.1"
  },
  "peerDependencies": {
    "@angular/core": "^22.2.0",
    "@angular/cli": "^22.2.1"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "files": [
    "**/*.js",
    "**/*.json",
    "starter/**",
    "README.md",
    "LICENSE"
  ]
}
